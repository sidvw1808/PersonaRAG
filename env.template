# Copy to .env and fill in.

# --- LLM: "claude" (Anthropic API) or "ollama" (local, free) ---
# Leave unset to auto-pick: claude if ANTHROPIC_API_KEY is set, otherwise ollama
# LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (lower = cheaper and faster)
CLAUDE_EFFORT=medium

# Local alternative (fits a 4 GB GPU):  ollama pull qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434

# --- Retrieval tuning ---
TOP_K=6
MIN_SIMILARITY=0.50
CHUNK_WORDS=300
CHUNK_OVERLAP_WORDS=50
